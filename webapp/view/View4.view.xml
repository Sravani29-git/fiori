<mvc:View
    controllerName="fragment.controller.View4"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Formatting Values Practice">
        <content>
            <VBox class="sapUiMediumMargin">

                <Label text="Name"/>
                <Input value="{empModel>/name}"/>

                <Label text="Date"/>
                <DatePicker
                    value="{empModel>/date}"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd/MM/yyyy"/>

                <Label text="Time"/>
                <TimePicker
                    value="{empModel>/time}"
                    valueFormat="HH:mm:ss"
                    displayFormat="hh:mm a"/>

                <Label text="Date Time"/>
                <DateTimePicker
                    value="{empModel>/dateTime}"
                    valueFormat="yyyy-MM-dd'T'HH:mm:ss"
                    displayFormat="dd/MM/yyyy hh:mm a"/>

                <Label text="Salary"/>
                <ObjectNumber
                    number="{
                        parts: [
                            {path: 'empModel>/salary'},
                            {path: 'empModel>/currency'}
                        ],
                        type: 'sap.ui.model.type.Currency'
                    }"/>

                <Label text="Rating"/>
                <Input
                    value="{
                        path: 'empModel>/rating',
                        type: 'sap.ui.model.type.Float',
                        formatOptions: { 
                            minFractionDigits: 2,
                            maxFractionDigits: 2
                        }
                    }"/>

            </VBox>
        </content>
    </Page>
</mvc:View>