<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        title="Line Item 1 - Table Data"
        contentWidth="750px"
        contentHeight="400px"
        draggable="true"
        resizable="true">

        <content>
            <Table
                items="{contractModel>/items}"
                inset="false">

                <columns>
                    <Column>
                        <Text text="Item No"/>
                    </Column>
                    <Column>
                        <Text text="Material"/>
                    </Column>
                    <Column>
                        <Text text="Description"/>
                    </Column>
                    <Column hAlign="End">
                        <Text text="Quantity"/>
                    </Column>
                    <Column hAlign="End">
                        <Text text="Price"/>
                    </Column>
                    <Column>
                        <Text text="Currency"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{contractModel>itemNo}"/>
                            <Text text="{contractModel>material}"/>
                            <Text text="{contractModel>description}"/>
                            <Text text="{contractModel>quantity}"/>
                            <Text text="{contractModel>price}"/>
                            <Text text="{contractModel>currency}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
        </content>

        <endButton>
            <Button text="Close" type="Reject" press="onCloseTableDialog"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>