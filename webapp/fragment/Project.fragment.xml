<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog title="Project Details" contentWidth="500px">
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                class="sapUiMediumMargin">

                <Label text="Project ID"/>
                <Input value="{projectModel>/projectId}" editable="{ui>/skillEdit}"/>

                <Label text="Project Name"/>
                <Input value="{projectModel>/name}" editable="{ui>/skillEdit}"/>

                <Label text="Status"/>
                <Input value="{projectModel>/status}" editable="{ui>/skillEdit}"/>

                <Label text="Budget"/>
                <Input value="{projectModel>/budget}" editable="{ui>/skillEdit}"/>

                <Label text="Technologies"/>
                <Input value="{projectModel>/technologyText}" editable="false"/>

                <Label text="Team Lead"/>
                <Input value="{projectModel>/lead}" editable="{ui>/skillEdit}"/>

                <Label text="Members"/>
                <Input value="{projectModel>/members}" editable="{ui>/skillEdit}"/>

            </f:SimpleForm>
        </content>

        <endButton>
            <Button text="Close" press="onClose"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>